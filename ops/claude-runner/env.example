# /etc/claude-runner.env  (root:root, mode 600). No secrets in this example.

# Where it listens: the gateway of the marketing-staging_marketing network.
#   docker network inspect marketing-staging_marketing -f '{{(index .IPAM.Config 0).Gateway}}'
CLAUDE_RUNNER_HOST=192.168.112.1
CLAUDE_RUNNER_PORT=8787
# Only this subnet may connect; anything else is closed before the token is read.
#   docker network inspect marketing-staging_marketing -f '{{(index .IPAM.Config 0).Subnet}}'
CLAUDE_RUNNER_ALLOW_CIDR=192.168.112.0/20

# At least 32 random bytes, hex (64+ characters) or base64; the runner refuses less.
# Written by README step 3 without putting it on a command line.
# The same value goes into the staging engine's CLAUDE_RUNNER_TOKEN.
CLAUDE_RUNNER_TOKEN=

# Limits. The Claude seat is shared with the ~/sales-team-automation crons.
CLAUDE_RUNNER_CONCURRENCY=2
CLAUDE_RUNNER_QUEUE=20
CLAUDE_RUNNER_TIMEOUT_MS=120000
CLAUDE_RUNNER_DAILY_CALLS=300

# The claude binary, and the PATH handed to it (systemd's default PATH
# does not include ~/.local/bin).
CLAUDE_BIN=/home/j.adas/.local/bin/claude
PATH=/home/j.adas/.local/bin:/usr/local/bin:/usr/bin:/bin
